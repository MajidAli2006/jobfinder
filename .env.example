# Copy to .env and fill in. Free keys, see README.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=

# Partner programmes. Indeed and ZipRecruiter serve a CAPTCHA to ordinary
# requests, so these are the only route to their listings. Both are optional:
# without a key the connector is skipped and reported, never a failed run.
# Indeed:       https://developer.indeed.com/
# ZipRecruiter: https://www.ziprecruiter.com/partner
# Glassdoor has no public API — it was retired when Indeed acquired them.
INDEED_PUBLISHER_ID=
ZIPRECRUITER_API_KEY=

# The one key worth having. Indeed, Glassdoor, Bayt, Naukri, Rozee and foundit
# all serve a CAPTCHA to direct requests, but all publish to Google's job index,
# and these vendors sell licensed access to it — in every country.
#
# Set ONE of the two, in the variable belonging to the site that issued it.
# They are not interchangeable: a SearchApi.io key placed in SERPAPI_KEY is
# rejected with "401 Invalid API key". SerpApi keys are 64 hex characters;
# SearchApi.io's are shorter. `jobfinder sources` names the vendor in use.
#
# https://serpapi.com/          free monthly allowance, paid beyond it
SERPAPI_KEY=
# https://www.searchapi.io/     same Google Jobs data, free allowance then paid
SEARCHAPI_KEY=

# Optional. Enables the Claude judgement layer (eligibility + fit scoring).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
